# Blue Lake Studio Environment Configuration
# Copy this file to .env and adjust for your private studio LAN.

# Default is dry-run. Set true only when your Fire TV IPs are correct and you
# want Blue Lake to send real local ADB commands.
BLUE_LAKE_ENABLE_ADB=false

# Server port
PORT=3000

# Bind locally by default. Use HOST=0.0.0.0 only if another device on your LAN
# needs to open Blue Lake in a browser.
HOST=127.0.0.1

# Shared ADB default
BLUE_LAKE_ADB_PORT=5555

# Studio network labels shown in the UI when privacy masking is off.
BLUE_LAKE_STUDIO_WIFI=studio-lan
BLUE_LAKE_GATEWAY=auto
BLUE_LAKE_DNS=auto

# Fire TV A: usually your Capture One client/proofing display.
FIRE_TV_A_NAME=Client Proof TV
FIRE_TV_A_IP=192.168.1.50
FIRE_TV_A_ADB_PORT=5555
FIRE_TV_A_ROLE=Capture One viewer
FIRE_TV_A_INPUT=HDMI 1

# Fire TV B: usually your DaVinci/reference playback display.
FIRE_TV_B_NAME=Reference Playback TV
FIRE_TV_B_IP=192.168.1.51
FIRE_TV_B_ADB_PORT=5555
FIRE_TV_B_ROLE=DaVinci review
FIRE_TV_B_INPUT=HDMI 1

# Optional app launch targets. Package names vary by receiver app.
BLUE_LAKE_SILK_PACKAGE=com.amazon.cloud9
BLUE_LAKE_CAPTURE_PACKAGE=
BLUE_LAKE_DAVINCI_PACKAGE=

# Optional review page to open in a Fire TV browser.
# Use an address reachable from the Fire TV, not localhost on your Mac.
BLUE_LAKE_REVIEW_URL=
